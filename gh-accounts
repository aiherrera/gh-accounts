#!/bin/bash
# gh-accounts — per-client GitHub accounts on macOS (gh + git + SSH + GPG + AI agent rules)
#
#   gh-accounts init           Install/refresh the gh wrapper, registry and AI rules
#   gh-accounts add            Add (or update) a client interactively
#   gh-accounts remove <slug>  Remove a client (keeps SSH/GPG keys)
#   gh-accounts import         Import clients from existing includeIf rules in ~/.gitconfig
#   gh-accounts list           List registered accounts
#   gh-accounts which          Show which account applies in the current folder
#   gh-accounts doctor         Verify everything is wired correctly
#   gh-accounts sync           Regenerate rules for CLAUDE.md / AGENTS.md / Cursor
#   gh-accounts version        Print version
#
# Registry: ~/.config/gh-accounts/accounts.tsv
#   slug <TAB> folder <TAB> gh_user <TAB> name <TAB> email <TAB> orgs(comma-separated)

set -euo pipefail

VERSION="1.0.0"

# When run as a gh extension (`gh accounts`), the wrapper may have injected a token.
# This tool manages tokens per account explicitly, so start clean.
unset GH_TOKEN GITHUB_TOKEN

CFG_DIR="$HOME/.config/gh-accounts"
REG="$CFG_DIR/accounts.tsv"
DEFAULT_FILE="$CFG_DIR/default"
REAL_GH_FILE="$CFG_DIR/real_gh"
WRAPPER="$HOME/.local/bin/gh"
RULE_FILES=("$HOME/.claude/CLAUDE.md" "$HOME/.codex/AGENTS.md")
TAB=$'\t'

# ---------- helpers ----------
ok()   { printf '\033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[33m!\033[0m %s\n' "$*"; }
err()  { printf '\033[31m✗\033[0m %s\n' "$*" >&2; }
step() { printf '\n\033[1m▸ %s\033[0m\n' "$*"; }
die()  { err "$*"; exit 1; }

ask() {
  local prompt="$1" def="${2:-}" ans
  if [ -n "$def" ]; then read -r -p "$prompt [$def]: " ans; else read -r -p "$prompt: " ans; fi
  printf '%s' "${ans:-$def}"
}
yes_no() { case "$(ask "$1 (y/n)" "${2:-y}")" in y|Y|yes|s|S|si|sí) return 0 ;; *) return 1 ;; esac; }

expand_path() { printf '%s' "${1/#\~/$HOME}"; }
tilde_path() {
  local p="${1%/}"
  case "$p" in "$HOME"|"$HOME"/*) printf '~%s' "${p#"$HOME"}" ;; *) printf '%s' "$p" ;; esac
}
lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

reg_lines() { [ -f "$REG" ] && grep -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$REG" || true; }
reg_has() { reg_lines | cut -f1 | grep -qx "$1"; }
default_user() { cat "$DEFAULT_FILE" 2>/dev/null || true; }

real_gh() {
  if [ -s "$REAL_GH_FILE" ] && [ -x "$(cat "$REAL_GH_FILE")" ]; then cat "$REAL_GH_FILE"; return; fi
  local p
  for p in $(type -ap gh 2>/dev/null) /opt/homebrew/bin/gh /usr/local/bin/gh; do
    [ "$p" = "$WRAPPER" ] && continue
    [ -x "$p" ] && { printf '%s' "$p"; return; }
  done
  die "Could not find the real gh binary. Install it with: brew install gh"
}

logged_users() {
  "$(real_gh)" auth status 2>&1 | sed -n 's/.*account \([^ ]*\).*/\1/p' | tr '\n' ' '
}

require_init() {
  [ -f "$REG" ] && [ -x "$WRAPPER" ] || die "Run first: gh-accounts init"
}

# Run gh as a specific user without touching the active account
gh_as() { GH_TOKEN="$("$RGH" auth token --user "$GHU")" "$RGH" "$@"; }

gh_as_or_refresh() {
  if gh_as "$@"; then return 0; fi
  warn "Missing scopes on $GHU. A browser will open: sign in as $GHU."
  "$RGH" auth switch -h github.com -u "$GHU" >/dev/null
  "$RGH" auth refresh -h github.com -s admin:public_key,write:gpg_key || true
  "$RGH" auth switch -h github.com -u "$DEF" >/dev/null
  gh_as "$@"
}

# ---------- wrapper ----------
write_wrapper() {
  mkdir -p "$(dirname "$WRAPPER")"
  cat > "$WRAPPER" <<'EOF'
#!/bin/bash
# Generated by gh-accounts: picks the GitHub account based on the current folder.
REAL_GH="__REAL_GH__"
CFG="$HOME/.config/gh-accounts"
GH_USER="$(cat "$CFG/default" 2>/dev/null)"
if [ -f "$CFG/accounts.tsv" ]; then
  while IFS=$'\t' read -r slug folder user _rest; do
    case "$slug" in ''|\#*) continue ;; esac
    dir="${folder/#\~/$HOME}"
    case "$PWD/" in "$dir/"*) GH_USER="$user"; break ;; esac
  done < "$CFG/accounts.tsv"
fi
if [ "$1" != "auth" ] && [ -z "$GH_TOKEN" ] && [ -n "$GH_USER" ]; then
  export GH_TOKEN="$("$REAL_GH" auth token --user "$GH_USER" 2>/dev/null)"
fi
exec "$REAL_GH" "$@"
EOF
  local rgh; rgh="$(real_gh)"
  sed -i.bak "s#__REAL_GH__#$rgh#" "$WRAPPER" && rm -f "$WRAPPER.bak"
  chmod +x "$WRAPPER"
}

ensure_path() {
  local line='export PATH="$HOME/.local/bin:$PATH"' f
  for f in "$HOME/.zshenv" "$HOME/.zshrc"; do
    touch "$f"
    if ! grep -qF '.local/bin:$PATH' "$f"; then
      printf '\n# gh-accounts\n%s\n' "$line" >> "$f"
      ok "PATH added to $(tilde_path "$f")"
    fi
  done
}

reg_write() { # slug folder user name email orgs
  local tmp; tmp="$(mktemp)"
  grep -v "^$1$TAB" "$REG" > "$tmp" || true
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$@" >> "$tmp"
  mv "$tmp" "$REG"
}

# ---------- AI rules ----------
rules_block() {
  local def_user def_name def_email
  def_user="$(default_user)"
  def_name="$(git config --global user.name || true)"
  def_email="$(git config --global user.email || true)"

  echo "## GitHub Accounts (multi-account setup)"
  echo "The GitHub account is selected automatically by folder. Never switch accounts manually."
  echo
  echo "| Folder | gh account | Git identity | SSH remote format |"
  echo "|---|---|---|---|"
  local slug folder user name email orgs org
  while IFS="$TAB" read -r slug folder user name email orgs; do
    org="${orgs%%,*}"; [ -n "$org" ] || org="<org>"
    echo "| $folder/ | $user | $name <$email> | git@github-$slug:$org/<repo>.git |"
  done < <(reg_lines)
  echo "| anywhere else | $def_user | $def_name <$def_email> | git@github.com:$def_user/<repo>.git |"
  echo
  echo "How it works:"
  echo "- \`gh\` is a wrapper (~/.local/bin/gh) that sets GH_TOKEN based on the current folder (registry: ~/.config/gh-accounts/accounts.tsv)."
  echo "- Git identity and GPG signing key come from \`includeIf\` in ~/.gitconfig."
  echo "- \`insteadOf\` rules rewrite github.com URLs of each client org to the right SSH host."
  echo
  echo "Rules:"
  echo "- NEVER run \`gh auth switch\`, \`gh auth login\`, or export GH_TOKEN manually."
  echo "- NEVER change \`user.name\`, \`user.email\`, or \`signingkey\` with \`git config\`."
  echo "- Before push, PR, issue, or release, verify with \`gh api user -q .login\` and \`git config user.email\`. If either doesn't match the table, stop and tell me."
  echo "- Clone client repos inside their folder; otherwise git uses my personal identity."
  echo "- Never use \`--no-gpg-sign\`."
}

cmd_sync() {
  require_init
  command -v python3 >/dev/null || die "python3 is required (install Xcode Command Line Tools)"
  local tmp; tmp="$(mktemp)"
  {
    echo "<!-- gh-accounts:start -->"
    rules_block
    echo "<!-- gh-accounts:end -->"
  } > "$tmp"

  python3 - "$tmp" "${RULE_FILES[@]}" <<'PY'
import os, re, sys
block = open(sys.argv[1]).read().rstrip("\n") + "\n"
S, E = "<!-- gh-accounts:start -->", "<!-- gh-accounts:end -->"
seen = set()
for f in sys.argv[2:]:
    if not os.path.isdir(os.path.dirname(f)):
        continue
    real = os.path.realpath(f)
    if real in seen:
        continue
    seen.add(real)
    t = open(real).read() if os.path.exists(real) else ""
    if S in t and E in t:
        t = t[:t.index(S)] + block.rstrip("\n") + t[t.index(E) + len(E):]
    else:
        m = re.search(r"^## GitHub Accounts.*?(?=^## |\Z)", t, flags=re.M | re.S)
        if m:
            t = t[:m.start()] + block + "\n" + t[m.end():]
        else:
            t = (t.rstrip() + "\n\n" if t.strip() else "") + block
    open(real, "w").write(t)
    print("  " + f.replace(os.path.expanduser("~"), "~", 1))
PY
  rm -f "$tmp"
  ok "AI rules updated in the files above"

  rules_block > "$CFG_DIR/cursor-rules.md"
  if command -v pbcopy >/dev/null; then
    pbcopy < "$CFG_DIR/cursor-rules.md"
    warn "Cursor: the rules block is in your clipboard. Paste it in Cursor Settings → Rules → User Rules (replace the previous one)."
  else
    warn "Cursor: paste ~/.config/gh-accounts/cursor-rules.md into Cursor Settings → Rules → User Rules."
  fi
}

# ---------- init / import ----------
cmd_init() {
  mkdir -p "$CFG_DIR"
  rm -f "$REAL_GH_FILE"
  real_gh > "$REAL_GH_FILE"
  ok "Real gh: $(cat "$REAL_GH_FILE")"

  if [ ! -s "$DEFAULT_FILE" ]; then
    local active
    active="$("$(real_gh)" auth status --active 2>/dev/null | sed -n 's/.*account \([^ ]*\).*/\1/p' | head -1 || true)"
    ask "Your personal GitHub account (default outside client folders)" "$active" > "$DEFAULT_FILE"
  fi
  [ -s "$DEFAULT_FILE" ] || die "A default account is required"
  ok "Default account: $(default_user)"

  if [ ! -f "$REG" ]; then
    printf '# slug\tfolder\tgh_user\tname\temail\torgs\n' > "$REG"
    ok "Registry created at ~/.config/gh-accounts/accounts.tsv"
  fi

  write_wrapper; ok "Wrapper installed at ~/.local/bin/gh"
  ensure_path

  if [ -z "$(reg_lines)" ]; then cmd_import; fi
  cmd_sync
  echo; ok "Done. Open a new terminal and run: gh-accounts doctor"
}

cmd_import() {
  [ -f "$REG" ] || die "Run first: gh-accounts init"
  step "Looking for existing per-folder setups (includeIf in ~/.gitconfig)"
  local found=0 key val folder gcfile base slug email name orgs user users
  users="$(logged_users)"
  while read -r key val <&3; do
    folder="${key#includeif.gitdir:}"; folder="${folder%.path}"
    folder="$(tilde_path "$(expand_path "$folder")")"
    gcfile="$(expand_path "$val")"
    base="$(basename "$gcfile")"; slug="${base#.gitconfig-}"
    [ "$slug" = "$base" ] && slug="$(lower "$(basename "$folder")")"
    slug="$(lower "$slug" | tr -cd 'a-z0-9-')"
    reg_has "$slug" && continue
    found=1
    email="$(git config -f "$gcfile" user.email 2>/dev/null || true)"
    name="$(git config -f "$gcfile" user.name 2>/dev/null || git config --global user.name || true)"
    orgs="$(git config --global --get-regexp "^url\.git@github-$slug:" 2>/dev/null \
      | sed -n "s#^url\.git@github-$slug:\([^/]*\)/\.insteadof .*#\1#p" | sort -u | paste -sd, - || true)"
    echo
    echo "  Found: $folder → $(tilde_path "$gcfile") (email: ${email:-?}, orgs: ${orgs:-—})"
    yes_no "  Import as '$slug'?" y || continue
    user="$(ask "  GitHub user for $folder (logged in: $users)")"
    [ -n "$user" ] || { warn "Skipped (no user)"; continue; }
    [ -n "$email" ] || email="$(ask "  Commit email")"
    reg_write "$slug" "$folder" "$user" "$name" "$email" "$orgs"
    ok "Imported $slug"
    grep -qE "^Host[[:space:]]+github-$slug\$" "$HOME/.ssh/config" 2>/dev/null \
      || warn "No 'Host github-$slug' in ~/.ssh/config. Run 'gh-accounts add' with slug '$slug' to create it."
  done 3< <(git config --global --get-regexp '^includeif\.gitdir:.*\.path$' 2>/dev/null || true)
  [ "$found" -eq 1 ] || ok "Nothing to import"
}

# ---------- add ----------
cmd_add() {
  require_init
  RGH="$(real_gh)"; DEF="$(default_user)"
  [ -n "$DEF" ] || die "No default account. Run: gh-accounts init"

  step "Client details"
  local slug folder name email orgs host key keyid="" def_name ex_folder="" ex_user="" ex_email="" ex_orgs=""
  slug="$(lower "$(ask "Short slug (e.g. acme)")" | tr -cd 'a-z0-9-')"
  [ -n "$slug" ] || die "Empty slug"
  if reg_has "$slug"; then
    warn "'$slug' already exists: it will be updated"
    IFS="$TAB" read -r _ ex_folder ex_user def_name ex_email ex_orgs < <(reg_lines | grep "^$slug$TAB")
  fi

  folder="$(ask "Repos folder" "${ex_folder:-~/Sites/$(printf '%s' "$slug" | tr '[:lower:]' '[:upper:]')}")"
  folder="$(tilde_path "$(expand_path "$folder")")"
  GHU="$(ask "Client GitHub user" "$ex_user")"; [ -n "$GHU" ] || die "Empty user"
  [ -n "${def_name:-}" ] || def_name="$(reg_lines | head -1 | cut -f4)"
  name="$(ask "Commit name" "${def_name:-$(git config --global user.name || true)}")"
  email="$(ask "Commit email" "$ex_email")"; [ -n "$email" ] || die "Empty email"
  orgs="$(ask "GitHub orgs, comma-separated (optional)" "$ex_orgs")"; orgs="${orgs// /}"
  host="github-$slug"; key="$HOME/.ssh/id_ed25519_$slug"

  echo
  echo "  Folder:   $folder"
  echo "  Account:  $GHU"
  echo "  Commits:  $name <$email>"
  echo "  SSH host: $host (key $(tilde_path "$key"))"
  echo "  Orgs:     ${orgs:-—}"
  local sign=1; yes_no "Sign commits with GPG?" y || sign=0
  yes_no "Continue?" y || die "Cancelled"

  step "gh account"
  if "$RGH" auth token --user "$GHU" >/dev/null 2>&1; then
    ok "$GHU is already authenticated"
  else
    warn "A browser will open: sign in as $GHU (not your personal account)."
    "$RGH" auth login -h github.com -p ssh -w --skip-ssh-key -s admin:public_key,write:gpg_key
    "$RGH" auth switch -h github.com -u "$DEF" >/dev/null
  fi
  [ "$(gh_as api user -q .login)" = "$GHU" ] || die "The token does not belong to $GHU"
  ok "Token for $GHU OK (active account is still $DEF)"

  step "SSH"
  mkdir -p "$HOME/.ssh"; chmod 700 "$HOME/.ssh"
  if [ ! -f "$key" ]; then
    ssh-keygen -t ed25519 -C "$email" -f "$key" -N "" -q; ok "Key created"
  else
    ok "Reusing existing key"
  fi
  ssh-add --apple-use-keychain "$key" 2>/dev/null || ssh-add "$key" 2>/dev/null || true
  touch "$HOME/.ssh/config"
  if ! grep -qE "^Host[[:space:]]+$host\$" "$HOME/.ssh/config"; then
    printf '\nHost %s\n    HostName github.com\n    User git\n    IdentityFile %s\n    IdentitiesOnly yes\n' \
      "$host" "$(tilde_path "$key")" >> "$HOME/.ssh/config"
    ok "Alias $host added to ~/.ssh/config"
  else
    ok "Alias $host already present"
  fi
  local pub; pub="$(cut -d' ' -f2 "$key.pub")"
  if gh_as api user/keys -q '.[].key' 2>/dev/null | grep -qF "$pub"; then
    ok "Key already on GitHub"
  else
    gh_as_or_refresh ssh-key add "$key.pub" -t "$(scutil --get ComputerName 2>/dev/null || hostname) ($slug)" \
      && ok "Key uploaded to $GHU" || warn "Could not upload the key; add it at github.com/settings/keys"
  fi
  if ssh -n -T -o StrictHostKeyChecking=accept-new "git@$host" 2>&1 | grep -q "Hi $GHU"; then
    ok "ssh -T git@$host → $GHU"
  else
    warn "ssh -T git@$host did not answer as $GHU (check the key on GitHub)"
  fi

  if [ "$sign" -eq 1 ]; then
    step "GPG"
    command -v gpg >/dev/null || die "gpg is missing: brew install gnupg pinentry-mac"
    keyid="$(gpg --list-secret-keys --keyid-format=long "$email" 2>/dev/null | awk '/^sec/{split($2,a,"/"); print a[2]; exit}')"
    if [ -z "$keyid" ]; then
      warn "Creating a GPG key; you will be asked for a passphrase."
      gpg --quick-gen-key "$name <$email>" ed25519 sign 0
      keyid="$(gpg --list-secret-keys --keyid-format=long "$email" | awk '/^sec/{split($2,a,"/"); print a[2]; exit}')"
    fi
    ok "GPG key: $keyid"
    if gh_as api user/gpg_keys -q '.[].key_id' 2>/dev/null | grep -qi "$keyid"; then
      ok "GPG key already on GitHub"
    else
      local gtmp; gtmp="$(mktemp)"; gpg --armor --export "$keyid" > "$gtmp"
      gh_as_or_refresh gpg-key add "$gtmp" && ok "GPG key uploaded to $GHU" \
        || warn "Could not upload the GPG key; add it at github.com/settings/keys"
      rm -f "$gtmp"
    fi
    warn "Make sure $email is verified on $GHU, or commits won't show as Verified."
  fi

  step "Git"
  local gc="$HOME/.gitconfig-$slug"
  {
    echo "[user]"
    echo "    name = $name"
    echo "    email = $email"
    if [ -n "$keyid" ]; then
      echo "    signingkey = $keyid"
      echo "[commit]"; echo "    gpgsign = true"
    else
      echo "[commit]"; echo "    gpgsign = false"
    fi
  } > "$gc"
  git config --global "includeIf.gitdir:$folder/.path" "~/.gitconfig-$slug"
  ok "includeIf $folder/ → ~/.gitconfig-$slug"

  clear_insteadof "$slug"
  if [ -n "$orgs" ]; then
    local org base org_list
    IFS=',' read -r -a org_list <<< "$orgs"
    for org in "${org_list[@]}"; do
      [ -n "$org" ] || continue
      base="url.git@$host:$org/"
      git config --global --add "$base.insteadOf" "git@github.com:$org/"
      git config --global --add "$base.insteadOf" "https://github.com/$org/"
      ok "insteadOf github.com/$org → $host"
    done
  fi

  step "Registry and folder"
  reg_write "$slug" "$folder" "$GHU" "$name" "$email" "$orgs"
  mkdir -p "$(expand_path "$folder")"
  ok "Registered; folder $folder ready"

  step "AI rules"
  cmd_sync

  echo
  ok "Client '$slug' ready. Clone with: git clone git@github.com:${orgs%%,*}/<repo>.git $folder/<repo>"
}

clear_insteadof() {
  local sect
  git config --global --get-regexp "^url\.git@github-$1:" 2>/dev/null | cut -d' ' -f1 | sed 's/\.insteadof$//' | sort -u \
    | while read -r sect; do git config --global --remove-section "$sect" 2>/dev/null || true; done
}

# ---------- remove ----------
cmd_remove() {
  require_init
  local slug="${1:-}"; [ -n "$slug" ] || die "Usage: gh-accounts remove <slug>"
  reg_has "$slug" || die "'$slug' is not registered"
  local folder; folder="$(reg_lines | grep "^$slug$TAB" | cut -f2)"
  yes_no "Remove '$slug' ($folder)? SSH/GPG keys and your repos are kept" n || die "Cancelled"
  local tmp; tmp="$(mktemp)"; grep -v "^$slug$TAB" "$REG" > "$tmp" || true; mv "$tmp" "$REG"
  git config --global --remove-section "includeIf.gitdir:$folder/" 2>/dev/null || true
  clear_insteadof "$slug"
  rm -f "$HOME/.gitconfig-$slug"
  ok "Removed '$slug' from registry, includeIf and insteadOf"
  warn "Kept: ~/.ssh/id_ed25519_$slug, 'Host github-$slug' in ~/.ssh/config, gh login and GPG key."
  cmd_sync
}

# ---------- list / which / doctor ----------
cmd_list() {
  require_init
  { printf 'SLUG\tFOLDER\tACCOUNT\tEMAIL\tORGS\n'
    reg_lines | awk -F'\t' '{print $1"\t"$2"\t"$3"\t"$5"\t"$6}'
    printf '(default)\t*\t%s\t%s\t\n' "$(default_user)" "$(git config --global user.email || true)"
  } | if command -v column >/dev/null; then column -t -s "$TAB"; else cat; fi
}

cmd_which() {
  require_init
  local user slug folder u dir
  user="$(default_user)"
  while IFS="$TAB" read -r slug folder u _; do
    dir="$(expand_path "$folder")"
    case "$PWD/" in "$dir/"*) user="$u"; break ;; esac
  done < <(reg_lines)
  echo "gh account: $user"
  if git rev-parse --git-dir >/dev/null 2>&1; then
    echo "git:        $(git config user.name) <$(git config user.email)>"
    echo "remote:     $(git remote get-url origin 2>/dev/null || echo '—')"
  fi
}

cmd_doctor() {
  require_init
  RGH="$(real_gh)"; DEF="$(default_user)"
  local fails=0

  step "Wrapper"
  if [ "$(zsh -c 'command -v gh' 2>/dev/null)" = "$WRAPPER" ]; then ok "Agents (zsh -c) use the wrapper"
  else err "zsh -c does not resolve gh to ~/.local/bin/gh"; fails=$((fails+1)); fi
  if [ "$("$RGH" auth status --active 2>/dev/null | sed -n 's/.*account \([^ ]*\).*/\1/p' | head -1)" = "$DEF" ]; then
    ok "Global active account: $DEF"
  else
    warn "Global active account is not $DEF (run: gh auth switch -u $DEF)"
  fi

  local slug folder user name email orgs host repo got
  while IFS="$TAB" read -r slug folder user name email orgs <&3; do
    step "$slug ($folder)"
    GHU="$user"; host="github-$slug"
    got="$(gh_as api user -q .login 2>/dev/null || true)"
    if [ "$got" = "$user" ]; then ok "gh token → $user"; else err "gh token for $user does not work"; fails=$((fails+1)); fi
    if ssh -n -T -o BatchMode=yes "git@$host" 2>&1 | grep -q "Hi $user"; then ok "ssh $host → $user"
    else err "ssh git@$host does not authenticate as $user"; fails=$((fails+1)); fi
    if git config --global --get "includeIf.gitdir:$folder/.path" >/dev/null; then ok "includeIf present"
    else err "Missing includeIf for $folder/"; fails=$((fails+1)); fi
    repo="$(find "$(expand_path "$folder")" -maxdepth 2 -name .git -type d 2>/dev/null | head -1 || true)"
    if [ -n "$repo" ]; then
      got="$(git -C "$(dirname "$repo")" config user.email || true)"
      if [ "$got" = "$email" ]; then ok "git email in $(basename "$(dirname "$repo")") → $email"
      else err "git email is '$got' (expected $email)"; fails=$((fails+1)); fi
    else
      warn "No repos yet in $folder to test git identity"
    fi
  done 3< <(reg_lines)

  echo
  [ "$fails" -eq 0 ] && ok "All good" || die "$fails problem(s) found"
}

usage() {
  sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
  echo "Also available as a gh extension: gh accounts <command>"
}

# ---------- main ----------
case "${1:-}" in
  init)   cmd_init ;;
  add)    cmd_add ;;
  remove|rm) shift; cmd_remove "${1:-}" ;;
  import) cmd_import; [ -x "$WRAPPER" ] && cmd_sync ;;
  list|ls) cmd_list ;;
  which)  cmd_which ;;
  doctor) cmd_doctor ;;
  sync)   cmd_sync ;;
  version|--version|-v) echo "gh-accounts $VERSION" ;;
  *) usage ;;
esac
